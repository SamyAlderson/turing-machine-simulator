# .gitignore

# Ignore generated files
__pycache__/
*.py[cod]

# Ignore IDE and editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.sln.docstates

# Ignore build and deploy files
build/
deploy/
dist/

# Ignore virtual environment
venv/

# Ignore node_modules
node_modules/

# Ignore other IDE and editor files
*.iml
*.tmp
*.log
*.pyc
*.class
*.swp
*.swo