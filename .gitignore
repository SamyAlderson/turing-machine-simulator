# .gitignore

# ignore ruff cache
.cache/ruff

# ignore ruff logs
.cache/ruff/logs

# ignore ruff config
.cache/ruff/config

# ignore ruff cache for specific files
.cache/ruff/*.pyc

# ignore other ruff cache
.cache/ruff/*

# ignore other files
*.pyc
*.pyo
*.class
*.log
*.cache
*.tmp
*.swp
*.swo
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.class
*.jar
*.war
*.ear
*.zip
*.tar
*.gz
*.bz2
*.xz
*.lz
*.lzma
*.7z
*.rar
*.zipx
*.egg
*.whl
